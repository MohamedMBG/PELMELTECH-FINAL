# Copy to .env.local for local development. NEVER commit real secrets.
# In production these are supplied by the environment (e.g. a systemd
# EnvironmentFile such as /etc/pelmeltech/pelmeltech.env), NOT by this file.
# Validate a target environment with:  npm run config:check

# NODE_ENV controls fail-secure behavior. In "production" the app REQUIRES
# ADMIN_PASSWORD, ADMIN_SECRET and DATABASE_URL, rejects the placeholder values
# below, and never falls back to the data/store.json file store.
NODE_ENV=development

# Shared admin settings (REQUIRED in production).
# ADMIN_SECRET should be >= 16 chars; ADMIN_PASSWORD a strong value.
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SECRET=replace-with-a-long-random-secret

# Postgres connection string (VPS or any standard Postgres server).
# REQUIRED in production. Optional locally — without it the app falls back to
# data/store.json (development only).
# On the VPS the DB is local: postgresql://user:password@localhost:5432/pelmeltech
# Self-signed cert? use ?sslmode=no-verify. No TLS (localhost)? drop the sslmode param.
DATABASE_URL=postgresql://user:password@localhost:5432/pelmeltech

# Monthly encrypted database backup (cron/timer + Resend). Optional.
# CRON_SECRET and BACKUP_ENCRYPTION_KEY should each be long random values.
CRON_SECRET=replace-with-a-random-string-at-least-16-characters
BACKUP_ENCRYPTION_KEY=replace-with-a-separate-random-string-at-least-32-characters
RESEND_API_KEY=re_xxxxxxxxx
BACKUP_EMAIL_FROM=PelmelTech Backups <backups@example.com>
BACKUP_EMAIL_TO=admin@example.com
