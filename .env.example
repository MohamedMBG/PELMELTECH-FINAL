# Shared admin settings
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SECRET=replace-with-a-long-random-secret

# Neon Postgres connection string.
# Required on Render. Optional locally because the app falls back to data/store.json.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Set on Vercel frontend only, after the Render backend is deployed.
# Example: https://pelmeltech-backend.onrender.com
BACKEND_URL=
